# ═══════════════════════════════════════════════════════════════
#  Copie este arquivo para `.env` (local) e preencha.
#  Em produção, cadastre estas variáveis no painel da Vercel.
#  NUNCA faça commit do arquivo .env.
# ═══════════════════════════════════════════════════════════════

# ── Banco de dados (PostgreSQL) ────────────────────────────────
# Local (Docker):  postgresql://postgres:postgres@localhost:5432/consultorio?schema=public
# Neon/Supabase:   use a string de conexão com ?sslmode=require
#                  Para `prisma migrate deploy` use a conexão DIRETA (sem pooler).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/consultorio?schema=public"

# ── URL pública do site (sem barra no final) ───────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Autenticação (Auth.js) ─────────────────────────────────────
# Gere com:  npm run gen:key
AUTH_SECRET=""
# Necessário atrás de proxy (Vercel já é confiável, mas não custa)
AUTH_TRUST_HOST="true"

# ── Criptografia do prontuário (AES-256-GCM) ───────────────────
# 32 bytes em base64. Gere com:  npm run gen:key
# ⚠ GUARDE UMA CÓPIA SEGURA DESTA CHAVE. Se for perdida, o prontuário
#   criptografado NÃO pode ser recuperado. Não a troque depois de ter dados.
CLINICAL_ENCRYPTION_KEY=""

# ── Cron (lembretes automáticos) ───────────────────────────────
# Qualquer string longa e aleatória. O agendador envia: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ── E-mail transacional (Resend) ───────────────────────────────
# Sem RESEND_API_KEY, os e-mails são apenas exibidos no terminal (modo desenvolvimento).
RESEND_API_KEY=""
# Domínio verificado no Resend (SPF/DKIM). Ex.: "Consultório <contato@seudominio.com.br>"
EMAIL_FROM="Consultório <onboarding@resend.dev>"
# Para onde vão os avisos destinados à psicóloga (novos agendamentos etc.). Se vazio, usa o e-mail do ADMIN.
EMAIL_ADMIN_NOTIFY=""

# ── Armazenamento de arquivos ──────────────────────────────────
# "local" = pasta .uploads (somente desenvolvimento) | "s3" = Cloudflare R2 / Supabase / AWS S3
STORAGE_DRIVER="local"
S3_ENDPOINT=""            # R2: https://<accountid>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Seed / conta ADMIN ─────────────────────────────────────────
# Usados por `npm run db:seed` e `npm run admin:create`.
SEED_ADMIN_NAME="Dra. Ana Exemplo"
SEED_ADMIN_EMAIL="admin@consultorio.local"
# Senha inicial (troque após o primeiro login). Mínimo 8, letras e números.
SEED_ADMIN_PASSWORD="Troque123senha"
# Apenas desenvolvimento: cria pacientes, sessões e pagamentos de exemplo
SEED_DEMO_DATA="true"

# ── Testes E2E (Playwright) ────────────────────────────────────
# Em E2E, os links de e-mail são lidos de um arquivo em vez de enviados.
E2E_MAIL_SINK="false"

# ── Testes de integração (banco DEDICADO – o nome deve conter "test") ──
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/consultorio_test?schema=public"
